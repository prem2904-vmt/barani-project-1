# Allow installs to proceed when a transitive plugin declares an outdated
# peer dependency on a Capacitor core version.
#
# Specifically: capacitor-plugin-callkit-voip@1.0.4 declares peer
# @capacitor/core@^4 but the underlying Swift CallKit/PushKit code is
# API-stable across Capacitor 4→8 and our local build + iOS pod install
# verify that. The plugin author hasn't bumped the peer range. Without
# this flag, `npm install` aborts and CI (DigitalOcean App Platform,
# Heroku, etc.) fails the build.
#
# If a Capacitor 8 fork of capacitor-plugin-callkit-voip becomes
# available, swap to it and delete this line.
legacy-peer-deps=true
