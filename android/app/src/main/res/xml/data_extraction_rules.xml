<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and device-to-device transfer keep everything as
     before EXCEPT the encrypted reply-from-notification credentials. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pf_chat_reply.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pf_chat_reply.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </device-transfer>
</data-extraction-rules>
