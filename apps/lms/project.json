{
  "name": "lms",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/lms/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/lms",
        "browser": "apps/lms/src/main.ts",
        "tsConfig": "apps/lms/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "stylePreprocessorOptions": {
          "sass": {
            "silenceDeprecations": [
              "import"
            ]
          }
        },
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/lms/public"
          },
          {
            "glob": "pdf.worker.min.mjs",
            "input": "node_modules/pdfjs-dist/build",
            "output": "assets"
          }
        ],
        "styles": [
          "apps/lms/src/styles.scss"
        ],
        "fileReplacements": [
          {
            "replace": "apps/lms/src/environments/environment.ts",
            "with": "apps/lms/src/environments/environment.production.ts"
          }
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "1.55mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "20kb",
              "maximumError": "2mb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/lms/src/environments/environment.ts",
              "with": "apps/lms/src/environments/environment.development.ts"
            }
          ]
        },
        "electron": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "1.55mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "20kb",
              "maximumError": "2mb"
            }
          ],
          "outputHashing": "all",
          "baseHref": "./",
          "fileReplacements": [
            {
              "replace": "apps/lms/src/environments/environment.ts",
              "with": "apps/lms/src/environments/environment.electron.ts"
            }
          ]
        },
        "capacitor": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "1.55mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "20kb",
              "maximumError": "2mb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/lms/src/environments/environment.ts",
              "with": "apps/lms/src/environments/environment.capacitor.ts"
            }
          ]
        },
        "stage": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "1.55mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "20kb",
              "maximumError": "2mb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/lms/src/environments/environment.ts",
              "with": "apps/lms/src/environments/environment.stage.ts"
            }
          ]
        },
        "capacitor-stage": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "1.55mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "20kb",
              "maximumError": "2mb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/lms/src/environments/environment.ts",
              "with": "apps/lms/src/environments/environment.capacitor-stage.ts"
            }
          ]
        },
        "electron-stage": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "1.55mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "20kb",
              "maximumError": "2mb"
            }
          ],
          "outputHashing": "all",
          "baseHref": "./",
          "fileReplacements": [
            {
              "replace": "apps/lms/src/environments/environment.ts",
              "with": "apps/lms/src/environments/environment.electron-stage.ts"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "lms:build:production"
        },
        "development": {
          "buildTarget": "lms:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {}
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "lms:build",
        "port": 4200,
        "staticFilePath": "dist/apps/lms/browser",
        "spa": true
      }
    }
  }
}
