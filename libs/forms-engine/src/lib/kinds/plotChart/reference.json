"audiogram":{"sources":["WHO grades of hearing impairment (World Report on Hearing, WHO 2021; Olusanya et al., Bull World Health Organ 2019;97:725-728): average of air-conduction thresholds at 0.5, 1, 2 and 4 kHz in dB HL. Normal below 20; mild 20 to below 35; moderate 35 to below 50; moderately severe 50 to below 65; severe 65 to below 80; profound 80 to below 95; complete 95 or more.","Type of loss from the air-bone gap (common clinical convention, not a WHO rule): bone-conduction average below 20 dB HL with an air-bone gap of 10 dB or more = conductive; air-bone gap below 10 dB = sensorineural; bone-conduction average of 20 dB HL or more with a gap of 10 dB or more = mixed."],"frequencies":[250,500,1000,2000,4000,8000],"ptaFrequencies":[500,1000,2000,4000],"minDb":-10,"maxDb":120,"stepDb":5,"normalBelowDb":20,"gapDb":10,"grades":[{"from":0,"name":"normal hearing"},{"from":20,"name":"mild"},{"from":35,"name":"moderate"},{"from":50,"name":"moderately severe"},{"from":65,"name":"severe"},{"from":80,"name":"profound"},{"from":95,"name":"complete"}]},"partograph":{"sources":["WHO modified partograph (WHO 2000, WHO/RHT/MSM/2000 revision; WHO Labour Care Guide 2020 replaces it): active phase starts at 4 cm; alert line = 1 cm per hour from 4 cm at hour 0 (10 cm at hour 6); action line = parallel, 4 hours to the right (4 cm at hour 4, 10 cm at hour 10). Fetal heart rate normal 110-160 beats per minute. Head descent in fifths palpable (5/5 to 0/5). Contractions counted per 10 minutes."],"startCm":4,"endCm":10,"alertCmPerHour":1,"actionOffsetHours":4,"maxHours":12,"fhrLow":110,"fhrHigh":160}}
