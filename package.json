{
  "name": "prefrontal",
  "productName": "Prefrontal",
  "version": "0.0.0",
  "description": "Prefrontal — clinical lab workflow.",
  "author": {
    "name": "Prefrontal Inc",
    "email": "support@prefrontal.in"
  },
  "license": "MIT",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "postinstall": "patch-package",
    "build": "NX_DAEMON=false NX_NO_CLOUD=true nx build lms && rm -rf public && cp -r dist/apps/lms/browser public && cp public/index.html public/404.html && rm -rf dist",
    "start": "nx serve lms",
    "electron": "electron .",
    "electron:dev": "concurrently \"npx nx serve lms\" \"wait-on http://localhost:4200 && electron .\"",
    "electron:build": "NX_DAEMON=false NX_NO_CLOUD=true npx nx build lms --configuration=electron && electron-builder",
    "electron:build:win": "NX_DAEMON=false NX_NO_CLOUD=true npx nx build lms --configuration=electron && electron-builder --win",
    "electron:build:mac": "NX_DAEMON=false NX_NO_CLOUD=true npx nx build lms --configuration=electron && electron-builder --mac",
    "electron:build:linux": "NX_DAEMON=false NX_NO_CLOUD=true npx nx build lms --configuration=electron && electron-builder --linux",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "NX_DAEMON=false NX_NO_CLOUD=true npx nx build lms --configuration=capacitor && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:run:ios": "npx cap run ios",
    "cap:run:android": "npx cap run android"
  },
  "build": {
    "appId": "in.prefrontal.app",
    "productName": "Prefrontal",
    "copyright": "Copyright © 2026 Prefrontal Inc",
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "electron/**/*",
      "dist/apps/lms/browser/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "electron/icon.png",
      "category": "public.app-category.medical"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "electron/icon.png",
      "category": "MedicalSoftware"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "electron/icon.png",
      "installerHeaderIcon": "electron/icon.png",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prefrontal LMS"
    }
  },
  "engines": {
    "node": "22.x",
    "npm": ">=11"
  },
  "private": true,
  "devDependencies": {
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "@angular-devkit/core": "~21.2.0",
    "@angular-devkit/schematics": "~21.2.0",
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@angular/language-service": "~21.2.0",
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "^22.6.5",
    "@nx/devkit": "22.6.5",
    "@nx/eslint": "22.6.5",
    "@nx/eslint-plugin": "22.6.5",
    "@nx/js": "22.6.5",
    "@nx/playwright": "22.6.5",
    "@nx/web": "22.6.5",
    "@oxc-project/runtime": "^0.115.0",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "~21.2.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/utils": "^8.40.0",
    "angular-eslint": "^21.2.0",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "jsdom": "^27.1.0",
    "nx": "22.6.5",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.5"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@angular/cdk": "~21.2.0",
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.1.0",
    "@capacitor/cli": "^7.6.2",
    "@capacitor/core": "^8.3.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@microsoft/signalr": "^10.0.0",
    "@preact/signals": "^2.9.0",
    "@schedule-x/angular": "^4.0.0",
    "@schedule-x/calendar": "^4.5.0",
    "@schedule-x/events-service": "^4.5.0",
    "@schedule-x/theme-default": "^4.5.0",
    "@supabase/supabase-js": "^2.103.3",
    "@tailwindcss/postcss": "^4.2.2",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "capacitor-plugin-callkit-voip": "^1.0.4",
    "date-fns": "^4.1.0",
    "electron-is-dev": "^3.0.1",
    "flatpickr": "^4.6.13",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "postcss": "^8.5.10",
    "preact": "^10.29.1",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.2.2",
    "temporal-polyfill": "^0.3.0",
    "uuid": "^13.0.0"
  }
}
