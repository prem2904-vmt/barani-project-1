{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@prefrontal/shared": ["libs/shared/src/index.ts"],
      "@prefrontal/forms-engine": ["libs/forms-engine/src/index.ts"],
      "@prefrontal/forms-engine/providers": ["libs/forms-engine/src/providers.ts"],
      "@prefrontal/forms-engine/testing": ["libs/forms-engine/src/testing.ts"]
    },
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  }
}
